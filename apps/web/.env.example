# EmailJS — Contact Form
# Get these values from your EmailJS dashboard (https://dashboard.emailjs.com)
# Add them to Vercel Environment Variables before deploying.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ipinfo.io — IP-based region detection middleware
# Get a token from https://ipinfo.io/account/token
# Add it to Vercel Environment Variables before deploying. Without it, the
# middleware falls back to the default region for every visitor.
IPINFO_TOKEN=

# Keystatic admin (/keystatic, /api/keystatic/*) — Basic Auth gate
# Required in every environment where the CMS should be reachable at all.
# Without both set, /keystatic and /api/keystatic/* deny all requests.
KEYSTATIC_BASIC_AUTH_USER=
KEYSTATIC_BASIC_AUTH_PASSWORD=

# Cloudflare Turnstile — contact form bot check
# Get a site key from https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
