# EmailJS — Contact Form
# Get these values from your EmailJS dashboard (https://dashboard.emailjs.com)
# Add them to Vercel Environment Variables before deploying. Server-only: the
# send now happens in app/api/contact/route.ts, not the browser.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=


# Keystatic admin (/keystatic, /api/keystatic/*) — Basic Auth gate
# Required in every environment where the CMS should be reachable at all.
# Without both set, /keystatic and /api/keystatic/* deny all requests.
KEYSTATIC_BASIC_AUTH_USER=
KEYSTATIC_BASIC_AUTH_PASSWORD=

# Cloudflare Turnstile — contact form bot check
# Get both from https://dash.cloudflare.com/?to=/:account/turnstile
# SITE_KEY is public (rendered client-side); SECRET is server-only, used in
# app/api/contact/route.ts to verify the token before sending any email.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
